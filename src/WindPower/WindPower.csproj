<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>WindPower</AssemblyName>
    <RootNamespace>WindPower</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Survival Log</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
    <ToolkitDll Condition="'$(ToolkitDll)' == ''">D:\devnew\game-mods\SurvivalLog\mods\sl-exiled-toolkit\src\ExiledToolkit\bin\Release\ExiledToolkit.dll</ToolkitDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\HotUpdate.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Interop)\AOT.dll" Private="false" />
    <Reference Include="$(Interop)\Vuplex.WebView.dll" Private="false" />
    <Reference Include="$(ToolkitDll)" Private="false" />
  </ItemGroup>

  <!-- The turbines' models and icons and the weather tooltip's page script travel inside the DLL, so installing the mod is still one file. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\WindTurbineMedium.glb" LogicalName="WindTurbineMedium.glb" />
    <EmbeddedResource Include="..\..\assets\UI_Item_Icon_WindTurbine_M.png" LogicalName="UI_Item_Icon_WindTurbine_M.png" />
    <EmbeddedResource Include="..\..\assets\WindTurbineLarge.glb" LogicalName="WindTurbineLarge.glb" />
    <EmbeddedResource Include="..\..\assets\UI_Item_Icon_WindTurbine_L.png" LogicalName="UI_Item_Icon_WindTurbine_L.png" />
    <EmbeddedResource Include="..\..\assets\WindTurbineSmall.glb" LogicalName="WindTurbineSmall.glb" />
    <EmbeddedResource Include="..\..\assets\UI_Item_Icon_WindTurbine_S.png" LogicalName="UI_Item_Icon_WindTurbine_S.png" />
    <EmbeddedResource Include="windpower.js" LogicalName="WindPower.windpower.js" />
  </ItemGroup>

  <!-- What the Mod Manager's Mods screen shows about this mod. -->
  <ItemGroup>
    <AssemblyMetadata Include="ModManager.Name" Value="Wind Power&#10;风力发电" />
    <AssemblyMetadata Include="ModManager.Description" Value="Adds craftable Small, Medium and Large Wind Turbines that make power outdoors, day and night.&#10;新增可制作的小型、中型和大型风力发电机，装在户外，昼夜发电。" />
    <AssemblyMetadata Include="ModManager.Author" Value="AnExiledDev" />
    <AssemblyMetadata Include="ModManager.Category" Value="Gameplay" />
    <AssemblyMetadata Include="ModManager.GameVersion" Value="1.1.20719" />
    <AssemblyMetadata Include="ModManager.Settings" Value="Live" />
    <AssemblyMetadata Include="ModManager.NexusId" Value="136" />
    <AssemblyMetadata Include="ModManager.GitHub" Value="AnExiledDev/SurvivalLog-WindPower" />
    <AssemblyMetadata Include="ModManager.Changelog" Value="https://github.com/AnExiledDev/SurvivalLog-WindPower/blob/main/CHANGELOG.md" />
  </ItemGroup>

</Project>
